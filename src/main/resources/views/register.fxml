<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="700.0" prefWidth="900.0" spacing="20.0"
      style="-fx-background-color: #D9D9D2;"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.muse.ui.controllers.RegisterController">
   <children>

      <!-- Logo Banner -->
      <HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity"
            prefHeight="111.0" prefWidth="409.0"
            style="-fx-background-color: #8B9D6E; -fx-background-radius: 40;">
         <children>
            <Label text="MUSE" textFill="#1A1A1A">
               <font><Font name="System Bold" size="96.0" /></font>
            </Label>
         </children>
         <VBox.margin><Insets top="40.0" /></VBox.margin>
      </HBox>

      <!-- Input Fields -->
      <VBox alignment="CENTER" maxWidth="-Infinity" prefWidth="450.0" spacing="15.0">
         <children>

            <!-- Email -->
            <HBox alignment="CENTER_LEFT" prefHeight="60.0"
                  style="-fx-background-color: #97A981; -fx-background-radius: 30;">
               <children>
                  <Label prefWidth="135.0" text="Email" textFill="WHITE">
                     <font><Font name="System Bold" size="18.0" /></font>
                     <HBox.margin><Insets left="20.0" /></HBox.margin>
                  </Label>
                  <TextField fx:id="emailField" prefHeight="60.0" prefWidth="315.0"
                             style="-fx-background-color: #8E987F; -fx-background-radius: 0 30 30 0; -fx-text-fill: white;"
                             HBox.hgrow="ALWAYS" />
               </children>
            </HBox>

            <!-- Username -->
            <HBox alignment="CENTER_LEFT" prefHeight="60.0"
                  style="-fx-background-color: #97A981; -fx-background-radius: 30;">
               <children>
                  <Label prefWidth="135.0" text="Username" textFill="WHITE">
                     <font><Font name="System Bold" size="18.0" /></font>
                     <HBox.margin><Insets left="20.0" /></HBox.margin>
                  </Label>
                  <TextField fx:id="usernameField" prefHeight="60.0" prefWidth="315.0"
                             style="-fx-background-color: #8E987F; -fx-background-radius: 0 30 30 0; -fx-text-fill: white;"
                             HBox.hgrow="ALWAYS" />
               </children>
            </HBox>

            <!-- Password -->
            <HBox alignment="CENTER_LEFT" prefHeight="60.0"
                  style="-fx-background-color: #97A981; -fx-background-radius: 30;">
               <children>
                  <Label prefWidth="135.0" text="Password" textFill="WHITE">
                     <font><Font name="System Bold" size="18.0" /></font>
                     <HBox.margin><Insets left="20.0" /></HBox.margin>
                  </Label>
                  <PasswordField fx:id="passwordField" prefHeight="60.0" prefWidth="315.0"
                                 style="-fx-background-color: #8E987F; -fx-background-radius: 0 30 30 0; -fx-text-fill: white;"
                                 HBox.hgrow="ALWAYS" />
               </children>
            </HBox>

            <!-- Confirm Password -->
            <HBox alignment="CENTER_LEFT" prefHeight="60.0"
                  style="-fx-background-color: #97A981; -fx-background-radius: 30;">
               <children>
                  <Label prefWidth="135.0" text="Repeat\nPassword" textFill="WHITE" wrapText="true">
                     <font><Font name="System Bold" size="13.0" /></font>
                     <HBox.margin><Insets left="20.0" /></HBox.margin>
                  </Label>
                  <PasswordField fx:id="confirmPasswordField" prefHeight="60.0" prefWidth="315.0"
                                 style="-fx-background-color: #8E987F; -fx-background-radius: 0 30 30 0; -fx-text-fill: white;"
                                 HBox.hgrow="ALWAYS" />
               </children>
            </HBox>

         </children>
         <VBox.margin><Insets top="20.0" /></VBox.margin>
      </VBox>

      <!-- Feedback Labels -->
      <Label fx:id="errorLabel" text="" textFill="#8B2020" wrapText="true" maxWidth="450.0">
         <font><Font name="System Bold" size="13.0" /></font>
      </Label>
      <Label fx:id="successLabel" text="" textFill="#2C6B2F" wrapText="true" maxWidth="450.0">
         <font><Font name="System Bold" size="13.0" /></font>
      </Label>

      <!-- Action Buttons -->
      <VBox alignment="CENTER" spacing="10.0">
         <children>
            <Button fx:id="registerButton" mnemonicParsing="false" onAction="#handleRegister"
                    prefHeight="60.0" prefWidth="200.0"
                    style="-fx-background-color: #829165; -fx-background-radius: 30;"
                    text="Create Account" textFill="WHITE">
               <font><Font name="System Bold" size="20.0" /></font>
            </Button>

            <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBackToLogin"
                    prefHeight="48.0" prefWidth="200.0"
                    style="-fx-background-color: #A9B298; -fx-background-radius: 30;"
                    text="Back to Login" textFill="WHITE">
               <font><Font name="System Bold" size="16.0" /></font>
            </Button>
         </children>
         <padding><Insets bottom="20.0" /></padding>
      </VBox>

   </children>
   <opaqueInsets><Insets /></opaqueInsets>
</VBox>
