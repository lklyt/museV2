<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="650.0" style="-fx-background-color: #C0B7AD; -fx-background-radius: 30; -fx-border-radius: 30;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <HBox alignment="CENTER" layoutX="14.0" layoutY="14.0" spacing="10.0" style="-fx-background-radius: 20;">
         <children>
            <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #FFD700;" text="★">
               <font>
                  <Font size="24.0" />
               </font>
            </Button>
            <Label text="3.4/5" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
         </children>
      </HBox>

      <ImageView fx:id="avatarImage" fitHeight="280.0" fitWidth="200.0" layoutX="80.0" layoutY="80.0" pickOnBounds="true" preserveRatio="true" />

      <HBox alignment="CENTER" layoutX="346.0" layoutY="25.0" prefHeight="40.0" prefWidth="280.0" style="-fx-background-color: #8E7F71; -fx-background-radius: 20;">
         <children>
            <Label fx:id="nameLabel" text="UserName" textFill="WHITE">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
         </children>
      </HBox>

      <VBox layoutX="346.0" layoutY="85.0" prefHeight="230.0" prefWidth="280.0" style="-fx-background-color: #8E7F71; -fx-background-radius: 20;">
         <children>
            <Label text="Comments" textFill="WHITE">
               <VBox.margin>
                  <Insets left="15.0" top="10.0" />
               </VBox.margin>
               <font>
                  <Font size="20.0" />
               </font>
            </Label>
            <ScrollPane hbarPolicy="NEVER" prefHeight="180.0" prefWidth="260.0" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;">
               <VBox.margin>
                  <Insets left="10.0" right="10.0" top="5.0" />
               </VBox.margin>
               <content>
                  <VBox prefHeight="200.0" prefWidth="100.0" />
               </content>
            </ScrollPane>
         </children>
      </VBox>

      <HBox alignment="CENTER" layoutX="346.0" layoutY="325.0" prefHeight="50.0" prefWidth="280.0" spacing="5.0">
         <children>
            <Button mnemonicParsing="false" style="-fx-background-color: transparent;" text="1" textFill="#ffd700"><font> <Font size="24.0" /> </font></Button>
            <Button mnemonicParsing="false" style="-fx-background-color: transparent;" text="2" textFill="#ffd700"><font> <Font size="24.0" /> </font></Button>
            <Button mnemonicParsing="false" style="-fx-background-color: transparent;" text="3" textFill="#ffd700"><font> <Font size="24.0" /> </font></Button>
            <Button mnemonicParsing="false" style="-fx-background-color: transparent;" text="4" textFill="WHITE"><font> <Font size="24.0" /> </font></Button>
            <Button mnemonicParsing="false" style="-fx-background-color: transparent;" text="5" textFill="WHITE"><font> <Font size="24.0" /> </font></Button>
         </children>
      </HBox>
   </children>
</AnchorPane>
