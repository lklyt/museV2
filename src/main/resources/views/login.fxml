<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="900.0" spacing="20.0"
      style="-fx-background-color: #D9D9D2;"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.muse.ui.controllers.LoginController">
   <children>

      <!-- Logo Banner -->
      <HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity"
            prefHeight="180.0" prefWidth="500.0"
            style="-fx-background-color: #8B9D6E; -fx-background-radius: 40;">
         <children>
            <Label text="MUSE" textFill="#1A1A1A">
               <font><Font name="System Bold" size="96.0" /></font>
            </Label>
         </children>
         <VBox.margin><Insets top="40.0" /></VBox.margin>
      </HBox>

      <!-- Input Fields -->
      <VBox alignment="CENTER" maxWidth="-Infinity" prefWidth="450.0" spacing="15.0">
         <children>
            <!-- Email / Username Row -->
            <HBox alignment="CENTER_LEFT" prefHeight="60.0"
                  style="-fx-background-color: #97A981; -fx-background-radius: 30;">
               <children>
                  <Label prefWidth="100.0" text="Email" textFill="WHITE">
                     <font><Font name="System Bold" size="18.0" /></font>
                     <HBox.margin><Insets left="20.0" /></HBox.margin>
                  </Label>
                  <TextField fx:id="usernameField" prefHeight="60.0" prefWidth="350.0"
                             style="-fx-background-color: #8E987F; -fx-background-radius: 0 30 30 0; -fx-text-fill: white;"
                             HBox.hgrow="ALWAYS" />
               </children>
            </HBox>

            <!-- Password Row -->
            <HBox alignment="CENTER_LEFT" prefHeight="60.0"
                  style="-fx-background-color: #ABB697; -fx-background-radius: 30;">
               <children>
                  <Label prefWidth="100.0" text="Password" textFill="WHITE">
                     <font><Font name="System Bold" size="18.0" /></font>
                     <HBox.margin><Insets left="20.0" /></HBox.margin>
                  </Label>
                  <PasswordField fx:id="passwordField" prefHeight="60.0" prefWidth="350.0"
                                 style="-fx-background-color: #98A086; -fx-background-radius: 0 30 30 0; -fx-text-fill: white;"
                                 HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
         </children>
         <VBox.margin><Insets top="30.0" /></VBox.margin>
      </VBox>

      <!-- Error Label -->
      <Label fx:id="errorLabel" text="" textFill="#8B2020" wrapText="true" maxWidth="450.0">
         <font><Font name="System Bold" size="13.0" /></font>
      </Label>

      <!-- Action Buttons -->
      <VBox alignment="CENTER" spacing="10.0">
         <children>
            <Button fx:id="loginButton" mnemonicParsing="false" onAction="#handleLogin"
                    prefHeight="60.0" prefWidth="180.0"
                    style="-fx-background-color: #829165; -fx-background-radius: 30;"
                    text="Login" textFill="WHITE">
               <font><Font name="System Bold" size="20.0" /></font>
            </Button>

            <Label text="Don't have an account?">
               <font><Font name="System Bold" size="14.0" /></font>
               <VBox.margin><Insets top="10.0" /></VBox.margin>
            </Label>

            <Button fx:id="registerButton" mnemonicParsing="false" onAction="#handleRegisterClick"
                    prefHeight="54.0" prefWidth="180.0"
                    style="-fx-background-color: #A9B298; -fx-background-radius: 30;"
                    text="Register" textFill="WHITE">
               <font><Font name="System Bold" size="20.0" /></font>
            </Button>
         </children>
         <VBox.margin><Insets top="10.0" /></VBox.margin>
         <padding><Insets bottom="20.0" /></padding>
      </VBox>

   </children>
</VBox>
