<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.muse.ui.controllers.LoginController">
  <padding>
    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
  </padding>
  <Label style="-fx-font-size: 32;" text="MUSE - Social Network" />
  <Separator />
  <VBox spacing="10.0">
    <Label style="-fx-font-size: 14;" text="Username" />
    <TextField fx:id="usernameField" promptText="Enter your username" />
    <Label style="-fx-font-size: 14;" text="Password" />
    <PasswordField fx:id="passwordField" promptText="Enter your password" />
  </VBox>
  <Label fx:id="errorLabel" style="-fx-text-fill: red; -fx-font-size: 12;" />
  <HBox spacing="10.0">
    <Button fx:id="loginButton" style="-fx-padding: 10; -fx-font-size: 14;" text="Login" />
    <Button fx:id="registerButton" style="-fx-padding: 10; -fx-font-size: 14;" text="Register" />
  </HBox>
</VBox>
